{
  "Serilog": {
    "Using": [],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId",
      "WithHangfireContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Hangfire": "Warning",
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information",

        "System.Net.Http.HttpClient": "Warning",
        "System.Net.Http.HttpClient.Default": "Warning",
        "Microsoft.Extensions.Http": "Warning"
      }
    },
    "Properties": {
      "Application": "API.Palantir"
    },
    "WriteTo": [
      {
        "Args": {
          "path": "D:\\SWP3D_LOG\\PnID\\PalantirAPI\\logs_.log",
          //"path": "E:\\SWP3D_Test\\SWP3D_LOG\\PnID\\PalantirAPI\\logs_.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information"
          //"retainedFileCountLimit": 5
        },
        "Name": "File"
      }
    ]
  }
}